{
  "expo": {
    "name": "Keeply",
    "slug": "keeply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keeply",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zeynepbass.keeply",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Fiş, fatura ve ürün fotoğraflarını çekebilmek için kamerana erişmemiz gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galerindeki fiş, fatura ve ürün görsellerini ekleyebilmen için fotoğraflarına erişmemiz gerekiyor."
      }
    },
    "android": {
      "package": "com.zeynepbass.keeply",
      "adaptiveIcon": {
        "backgroundColor": "#176B50",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#111613",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fiş ve faturalarını tarayabilmek için kamerana erişmemiz gerekiyor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerindeki fiş, fatura ve ürün görsellerini ekleyebilmen için fotoğraflarına erişmemiz gerekiyor.",
          "cameraPermission": "Ürün fotoğrafı çekebilmek için kamerana erişmemiz gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176B50"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
